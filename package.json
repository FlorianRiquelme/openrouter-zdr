{
	"name": "openrouter-zdr",
	"version": "0.1.2",
	"description": "OpenRouter chat client that only ever routes to zero-data-retention endpoints, with per-module model resolution and zod structured output.",
	"keywords": [
		"openrouter",
		"zdr",
		"zero-data-retention",
		"privacy",
		"gdpr",
		"llm",
		"ai",
		"chat-completions",
		"structured-output",
		"zod",
		"json-schema",
		"typescript",
		"esm"
	],
	"license": "MIT",
	"author": "Florian Riquelme",
	"homepage": "https://github.com/FlorianRiquelme/openrouter-zdr#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FlorianRiquelme/openrouter-zdr.git"
	},
	"bugs": {
		"url": "https://github.com/FlorianRiquelme/openrouter-zdr/issues"
	},
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.17.0",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"bin": {
		"openrouter-zdr": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && git diff --exit-code -- dist"
	},
	"peerDependencies": {
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@types/node": "^26",
		"typescript": "^5",
		"vitest": "^4.1.10",
		"zod": "^4.5.4"
	}
}
